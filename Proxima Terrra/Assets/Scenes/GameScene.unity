  m_Script: {fileID: 11500000, guid: 50896874b7a871c4fb512514a726dc7b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PersonController
  dialogueController: {fileID: 823953534}
  _isWriting: 0
  playerController: {fileID: 823953530}
  dialogueText: {fileID: 472259251}
  personNameText: {fileID: 1370645325}
  protaAudio: {fileID: 0}
  npcAudio: {fileID: 8300000, guid: b077fbc06095ae547a3dda5ff04af1b1, type: 3}
  dialogueIndexes: 
  lines:
  - "aOi, voc\xEA \xE9 a cientista da nave n\xE9? N\xE3o te vi muito na Nave-M\xE3e."
  - "h\xC9, eu tendo a focar bastante nos meus estudos, estava muito intrigada pois
    encontrei poss\xEDveis sinais de vida nesse planeta."
  - "aQue interessante, n\xE3o lembro de ler nada sobre isso nos arquivos da miss\xE3o."
  - "h\xC9 apenas uma hip\xF3tese distante e recente por enquanto, mas vou investigar
    mais enquanto estiver aqui."
  - "aEntendi, foi bom conversar com voc\xEA."
  - "hIgualmente, voc\xEA \xE9 a \xFAnica pessoa que parece realmente interessada
    na miss\xE3o, talvez voc\xEA seja boa pra me ajudar."
  - aEu adoraria.
  - hOi, precisa de mim?
  - "aComo est\xE1 suas investiga\xE7\xF5es?"
  - "hAinda n\xE3o descobri nada perto de concreto."
  - aAh ok, me mantenha atualizada.
  - hEu vou.
  - "aOl\xE1 Hana, como v\xE3o os estudos?"
  i: 0
